# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
/local-first/web-dist/
/local-first/relay/.wrangler/
# ContactGraph data must never enter a public Pages repository or artifact.
/public/contacts.json
/public/photos/
*.duckdb
*.duckdb.wal
/firebase-pages-dist/
/firebase-pages/.env*
/firebase-pages/*service-account*.json
/firestore-debug.log
/ui-debug.log
*.cgbak

# This repository is intended to be public. Commit only the static Pages
# application and migration tooling; the Hermes runtime and private data stay
# in the local synced folder.
/*
!/.gitignore
!/.github/
!/app/
/app/*
!/app/page.tsx
!/app/contact-graph.tsx
!/app/holiday-module.tsx
!/app/canva-module.tsx
!/app/accounts-module.tsx
!/app/contact-message-history.tsx
!/app/contact-osint-history.tsx
!/app/birthday-module.tsx
!/app/duplicates-module.tsx
!/app/meetings-module.tsx
!/app/followups-module.tsx
!/app/contact-followup-reminders.tsx
!/app/osint-module.tsx
!/app/offline-status.tsx
!/app/auth-context.tsx
!/app/settings-module.tsx
!/app/sync-settings.tsx
!/app/globals.css
!/components/
/components/*
!/components/ui/
!/hooks/
/hooks/*
!/hooks/use-mobile.ts
!/lib/
/lib/*
!/lib/utils.ts
!/firebase-pages/
!/public/
/public/*
!/public/favicon.svg
!/public/window.svg
!/public/globe.svg
!/public/file.svg
!/public/manifest.webmanifest
!/public/service-worker.js
!/docs/
/docs/*
!/docs/firebase-pages-threat-model.md
!/package.json
!/package-lock.json
!/postcss.config.mjs
!/tsconfig.json
!/vite.firebase.config.ts
!/vendor/
/vendor/*
!/vendor/shadcn-tailwind-4.13.0.css
!/vendor/shadcn-tailwind-4.13.0.LICENSE.md
!/scripts/
/scripts/*
!/scripts/osint-search.mjs
