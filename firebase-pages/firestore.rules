rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.token.email);
    }
    function activeMember() {
      return googleUser() && exists(memberPath()) && get(memberPath()).data.active == true;
    }
    function memberRole() { return get(memberPath()).data.role_id; }
    function rolePath() { return /databases/$(database)/documents/roles/$(memberRole()); }
    function allowed(permission) {
      return activeMember() && (memberRole() == 'owner'
        || (exists(rolePath()) && permission in get(rolePath()).data.permissions));
    }
    function validRecord(id) {
      return request.resource.data.id == id
        && !request.resource.data.keys().hasAny(['photo_url', 'pending_sync'])
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updated_at is string
        && request.resource.data.updated_by == request.auth.uid;
    }
    function validUpdate(id) {
      return validRecord(id) && request.resource.data.revision == resource.data.revision + 1;
    }
    function validContact(id) {
      return validRecord(id)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 300;
    }
    function knownPermissions() {
      // Generated by scripts/generate_permission_catalog.py.
      return ['contacts.view', 'contacts.create', 'contacts.edit', 'contacts.delete', 'contacts.merge', 'tags.edit', 'tags.merge', 'meetings.view', 'meetings.create', 'meetings.edit', 'meetings.delete', 'followups.view', 'followups.manage', 'holidays.view', 'holidays.manage', 'drafts.view', 'drafts.manage', 'duplicates.view', 'duplicates.manage', 'graph.view', 'canvases.view', 'canvases.manage', 'osint.view', 'osint.manage', 'settings.manage', 'sync.read', 'sync.write', 'sync.run', 'users.manage'];
    }
    function validSyncRequest(id) {
      return id == 'threeway'
        && request.resource.data.id == id
        && request.resource.data.status == 'queued'
        && request.resource.data.request_id is string
        && request.resource.data.request_id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && request.resource.data.requested_at is string
        && request.resource.data.requested_at.size() <= 35
        && request.resource.data.requested_by == request.auth.uid;
    }

    match /sync_control/{id} {
      allow get: if allowed('sync.run') && id == 'threeway';
      allow list, delete: if false;
      allow create: if allowed('sync.run') && validSyncRequest(id)
        && request.resource.data.keys().hasOnly(['id', 'status', 'request_id', 'requested_at', 'requested_by']);
      allow update: if allowed('sync.run') && validSyncRequest(id)
        && resource.data.status in ['idle', 'succeeded', 'failed', 'conflicts']
        && request.resource.data.request_id != resource.data.get('request_id', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'request_id', 'requested_at', 'requested_by']);
    }

    match /members/{email} {
      allow get: if activeMember() && (email == request.auth.token.email || allowed('users.manage'));
      allow list: if allowed('users.manage');
      allow create: if allowed('users.manage') && request.resource.data.email == email
        && request.resource.data.role_id != 'owner' && request.resource.data.active is bool;
      allow update: if allowed('users.manage') && resource.data.role_id != 'owner'
        && request.resource.data.email == email && request.resource.data.role_id != 'owner'
        && request.resource.data.active is bool;
      allow delete: if allowed('users.manage') && resource.data.role_id != 'owner';
    }
    match /roles/{id} {
      allow get: if activeMember();
      allow list: if allowed('users.manage');
      allow create, update: if allowed('users.manage') && id != 'owner'
        && request.resource.data.id == id && request.resource.data.permissions is list
        && 'contacts.view' in request.resource.data.permissions
        && request.resource.data.permissions.hasOnly(knownPermissions());
      allow delete: if false;
    }
    match /contacts/{id} {
      allow read: if allowed('contacts.view');
      allow create: if allowed('contacts.create') && validContact(id) && request.resource.data.revision == 1;
      allow update: if (allowed('contacts.edit') || allowed('contacts.merge') ||
          (allowed('tags.edit') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['labels', 'revision', 'updated_at', 'updated_by'])))
        && validContact(id) && validUpdate(id);
      // A merge removes source records; merge permission alone cannot delete them.
      allow delete: if allowed('contacts.delete');
    }
    match /meetings/{id} {
      allow read: if allowed('meetings.view');
      allow create: if allowed('meetings.create') && validRecord(id) && request.resource.data.revision == 1
        && request.resource.data.contact_ids is list && request.resource.data.contact_ids.size() > 0
        && request.resource.data.insights is string;
      allow update: if allowed('meetings.edit') && validUpdate(id);
      allow delete: if allowed('meetings.delete');
    }
    match /followup_actions/{id} {
      allow read: if allowed('followups.view');
      allow create: if allowed('followups.manage') && validRecord(id) && request.resource.data.revision == 1
        && request.resource.data.contact_id is string && request.resource.data.title is string
        && request.resource.data.due_date is string;
      allow update: if allowed('followups.manage') && validUpdate(id);
      allow delete: if allowed('followups.manage');
    }
    match /followup_settings/{id} {
      allow read: if allowed('followups.view');
      allow create: if allowed('followups.manage') && validRecord(id) && request.resource.data.revision == 1;
      allow update: if allowed('followups.manage') && validUpdate(id);
      allow delete: if allowed('followups.manage');
    }
    function validColumn(board, index) {
      return index >= board.column_order.size() || (
        board.column_order[index] is string
        && board.column_order[index].size() > 0 && board.column_order[index].size() <= 100
        && !(board.column_order[index] in ['__proto__', 'constructor', 'prototype'])
        && board.columns[board.column_order[index]] is string
        && board.columns[board.column_order[index]].size() > 0
        && board.columns[board.column_order[index]].size() <= 80);
    }
    function validKanban(board) {
      return board is map && (board.size() == 0 || (
        board.keys().hasOnly(['columns', 'column_order', 'assignments', 'card_order'])
        && board.keys().hasAll(['columns', 'column_order', 'assignments', 'card_order'])
        && board.columns is map && board.columns.size() <= 20
        && board.column_order is list && board.column_order.size() == board.columns.size()
        && board.column_order.toSet().size() == board.column_order.size()
        && board.column_order.toSet() == board.columns.keys().toSet()
        && board.assignments is map && board.assignments.size() <= 500
        && board.assignments.values().hasOnly(board.columns.keys())
        && board.card_order is list && board.card_order.size() <= 500
        && board.card_order.toSet().size() == board.card_order.size()
        && validColumn(board, 0) && validColumn(board, 1) && validColumn(board, 2) && validColumn(board, 3) && validColumn(board, 4) && validColumn(board, 5) && validColumn(board, 6) && validColumn(board, 7) && validColumn(board, 8) && validColumn(board, 9) && validColumn(board, 10) && validColumn(board, 11) && validColumn(board, 12) && validColumn(board, 13) && validColumn(board, 14) && validColumn(board, 15) && validColumn(board, 16) && validColumn(board, 17) && validColumn(board, 18) && validColumn(board, 19)
      ));
    }
    function validCanvas() {
      return request.resource.data.title is string
        && request.resource.data.nodes is list && request.resource.data.nodes.size() <= 500
        && (!('kanban' in request.resource.data) || validKanban(request.resource.data.kanban));
    }
    match /canvases/{id} {
      allow read: if allowed('canvases.view');
      allow create: if allowed('canvases.manage') && validRecord(id) && request.resource.data.revision == 1
        && validCanvas();
      allow update: if allowed('canvases.manage') && validUpdate(id) && validCanvas()
        && (!('kanban' in resource.data) || 'kanban' in request.resource.data);
      allow delete: if allowed('canvases.manage');
    }
    match /holidays/{id} {
      allow read: if allowed('holidays.view');
      allow create: if allowed('holidays.manage') && validRecord(id) && request.resource.data.revision == 1;
      allow update: if allowed('holidays.manage') && validUpdate(id);
      allow delete: if allowed('holidays.manage');
    }
    match /holiday_messages/{id} {
      allow read: if allowed('drafts.view');
      allow create: if allowed('drafts.manage') && validRecord(id) && request.resource.data.revision == 1;
      allow update: if allowed('drafts.manage') && validUpdate(id);
      allow delete: if allowed('drafts.manage');
    }
    match /photo_chunks/{id} {
      allow read: if allowed('contacts.view');
      function validPhoto() {
        return allowed('contacts.edit')
        && request.resource.data.id == id
        && request.resource.data.contact_id is string
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 20
        && request.resource.data.index < request.resource.data.total
        && id == request.resource.data.contact_id + '_' + string(request.resource.data.index)
        && existsAfter(/databases/$(database)/documents/contacts/$(request.resource.data.contact_id))
        && request.resource.data.mime in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.data.sha256 is string
        && request.resource.data.sha256.matches('^[0-9a-f]{64}$')
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 700000;
      }
      allow create: if validPhoto();
      allow update: if validPhoto()
        && request.resource.data.contact_id == resource.data.contact_id
        && request.resource.data.index == resource.data.index;
      allow delete: if allowed('contacts.edit');
    }
    match /{document=**} { allow read, write: if false; }
  }
}
