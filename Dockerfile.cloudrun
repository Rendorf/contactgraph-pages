FROM node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS dependencies
WORKDIR /app
COPY cloudrun/package.json cloudrun/package-lock.json .npmrc ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-venv \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node cloudrun/package.json ./package.json
COPY --chown=node:node cloudrun/requirements.txt ./requirements.txt
RUN python3 -m venv /opt/contactgraph-venv \
  && /opt/contactgraph-venv/bin/pip install --no-cache-dir -r requirements.txt
COPY --chown=node:node scripts ./scripts
ENV CONTACTGRAPH_PYTHON=/opt/contactgraph-venv/bin/python \
  CONTACTGRAPH_OSINT_ENABLED=1 \
  CONTACTGRAPH_OSINT_STORE=firestore \
  CONTACTGRAPH_OSINT_ALLOW_RSSHUB=0 \
  NODE_ENV=production \
  PORT=8080
USER node
EXPOSE 8080
CMD ["node", "scripts/cloudrun-server.mjs"]
